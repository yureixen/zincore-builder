# Toolchain
export CLANG_SOURCE=googlesource

# Compile optimization
export LTO_MODE=thin

# ReSukiSU
export KSU_SETUP_URL=https://raw.githubusercontent.com/ReSukiSU/ReSukiSU/refs/heads/main/kernel/setup.sh
export KSU_SETUP_ARG=main

# SuSFS
export SUSFS_HOOK_URL=https://raw.githubusercontent.com/JackA1ltman/NonGKI_Kernel_Build_2nd/mainline/Patches/susfs_inline_hook_patches.sh
export SUSFS_PATCH_BASE=https://raw.githubusercontent.com/JackA1ltman/NonGKI_Kernel_Build_2nd/mainline/Patches/Patch

# Build identity
export KBUILD_BUILD_USER=yureixen-compile
export KBUILD_BUILD_HOST=zincore.build
