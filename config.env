# Kernel Source
KERNEL_REPO=https://github.com/yureixen/android_kernel_xiaomi_sm6150.git
KERNEL_BRANCH=sixteen-qpr2
KERNEL_DEFCONFIG=sweet_defconfig
KERNEL_VERSION=4.14

# AnyKernel3
AK3_REPO=https://github.com/yureixen/AnyKernel3.git
AK3_BRANCH=sweet

# ReSukiSU
KSU_SETUP_URL=https://raw.githubusercontent.com/ReSukiSU/ReSukiSU/refs/heads/main/kernel/setup.sh
KSU_SETUP_ARG=main

# SuSFS
SUSFS_HOOK_URL=https://raw.githubusercontent.com/JackA1ltman/NonGKI_Kernel_Build_2nd/mainline/Patches/susfs_inline_hook_patches.sh
SUSFS_PATCH_BASE=https://raw.githubusercontent.com/JackA1ltman/NonGKI_Kernel_Build_2nd/mainline/Patches/Patch

# Build identity
KBUILD_BUILD_USER=yureixen-compile
KBUILD_BUILD_HOST=zincore.build
